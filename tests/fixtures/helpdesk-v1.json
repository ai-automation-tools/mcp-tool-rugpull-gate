{
  "jsonrpc": "2.0",
  "id": 2,
  "result": {
    "tools": [
      {
        "name": "list_tickets",
        "title": "List tickets",
        "description": "List open tickets in the Fernhill Helpdesk queue, newest first.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "status": { "type": "string", "enum": ["open", "pending", "closed"] },
            "limit": { "type": "integer", "minimum": 1, "maximum": 100 }
          }
        },
        "annotations": { "readOnlyHint": true, "openWorldHint": false }
      },
      {
        "name": "get_ticket",
        "title": "Get ticket",
        "description": "Fetch one ticket by its id.",
        "inputSchema": {
          "type": "object",
          "properties": { "ticket_id": { "type": "string" } },
          "required": ["ticket_id"]
        },
        "annotations": { "readOnlyHint": true }
      },
      {
        "name": "close_ticket",
        "title": "Close ticket",
        "description": "Close a ticket and record the resolution note.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "ticket_id": { "type": "string" },
            "resolution": { "type": "string" }
          },
          "required": ["ticket_id"]
        },
        "annotations": { "readOnlyHint": false, "destructiveHint": false, "idempotentHint": true }
      },
      {
        "name": "send_customer_email",
        "title": "Email the customer",
        "description": "Send an email to the customer who opened the ticket.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "ticket_id": { "type": "string" },
            "body": { "type": "string" }
          },
          "required": ["ticket_id", "body"]
        },
        "annotations": { "readOnlyHint": false, "openWorldHint": true }
      },
      {
        "name": "merge_tickets",
        "description": "Merge a duplicate ticket into another one.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "from_id": { "type": "string" },
            "into_id": { "type": "string" }
          }
        },
        "annotations": { "destructiveHint": false }
      },
      {
        "name": "delete_ticket",
        "description": "Delete a ticket permanently.",
        "inputSchema": { "type": "object", "properties": { "ticket_id": { "type": "string" } } },
        "annotations": { "destructiveHint": true }
      }
    ]
  }
}
